{
  "name": "clash-verge",
  "version": "2.5.9",
  "license": "GPL-3.0-only",
  "overrides": {
    "mdast-util-gfm-autolink-literal": "2.0.0"
  },
  "scripts": {
    "prepare": "husky || true",
    "dev": "bun scripts/dev.mjs dev",
    "dev:service": "bun scripts/dev.mjs service",
    "dev:sidecar": "bun scripts/dev.mjs sidecar",
    "dev:diff": "bun scripts/dev.mjs dev",
    "dev:trace": "bun scripts/dev.mjs trace",
    "dev:tauri": "RUST_BACKTRACE=full tauri dev -f tauri-dev",
    "build": "NODE_OPTIONS=--max-old-space-size=4096 tauri build",
    "build:fast": "NODE_OPTIONS=--max-old-space-size=4096 tauri build -- --profile fast-release",
    "tauri": "tauri",
    "web:dev": "vite",
    "web:build": "tsc --noEmit && vite build",
    "web:serve": "vite preview",
    "prebuild:download": "bun scripts/prebuild.mjs",
    "sync:dev": "bun scripts/sync-dev.mjs",
    "updater": "bun scripts/updater.mjs",
    "updater-fixed-webview2": "bun scripts/updater-fixed-webview2.mjs",
    "release-version": "bun scripts/release-version.mjs",
    "release:autobuild": "bun run release-version autobuild",
    "release:deploytest": "bun run release-version deploytest",
    "lint": "oxlint src",
    "lint:fix": "oxlint src --fix",
    "format": "oxfmt .",
    "format:check": "oxfmt --check .",
    "hygiene": "bun scripts/check-file-hygiene.mjs",
    "i18n:check": "bun scripts/cleanup-unused-i18n.mjs",
    "i18n:verify": "bun scripts/cleanup-unused-i18n.mjs --check",
    "i18n:format": "bun scripts/cleanup-unused-i18n.mjs --align --apply",
    "i18n:types": "bun scripts/generate-i18n-keys.mjs",
    "gen:contract": "bun scripts/gen-contract.mjs",
    "arch:check": "bun scripts/check-architecture.mjs listen emit invoke",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "knip:check": "knip",
    "knip:report": "knip --no-exit-code",
    "perf:build": "bun scripts/perf/build.mjs",
    "perf:run": "bun scripts/perf/run.mjs",
    "perf:compare": "bun scripts/perf/compare.mjs",
    "perf:test": "bun test scripts/perf/report.test.mjs scripts/perf/bundle-budget.test.mjs",
    "perf:frontend-baseline": "bun scripts/perf/frontend-baseline.mjs --dist dist --label local-2026-10-26 --out docs/perf/frontend-baseline.json",
    "check:bundle-budget": "bun scripts/check-bundle-budget.mjs --dist dist",
    "check:hex-budget": "bun scripts/check-hex-budget.mjs"
  },
  "dependencies": {
    "@dnd-kit/collision": "^0.5.0",
    "@dnd-kit/dom": "^0.5.0",
    "@dnd-kit/helpers": "^0.5.0",
    "@dnd-kit/react": "^0.5.0",
    "@emotion/react": "^11.14.0",
    "@emotion/styled": "^11.14.1",
    "@juggle/resize-observer": "^3.4.0",
    "@monaco-editor/react": "^4.7.0",
    "@mui/icons-material": "^9.4.0",
    "@mui/material": "^9.4.0",
    "@tanstack/react-virtual": "^3.14.13",
    "@tauri-apps/api": "2.12.4",
    "@tauri-apps/plugin-clipboard-manager": "2.5.0",
    "@tauri-apps/plugin-dialog": "2.8.3",
    "@tauri-apps/plugin-fs": "2.7.1",
    "@tauri-apps/plugin-opener": "2.7.2",
    "ahooks": "^3.10.0",
    "cidr-block": "^2.3.0",
    "compare-versions": "^6.1.1",
    "dayjs": "1.11.23",
    "foxact": "^0.3.12",
    "foxts": "^5.9.1",
    "i18next": "^26.4.2",
    "js-yaml": "^5.4.2",
    "lodash-es": "^4.18.1",
    "meta-json-schema": "^1.19.31",
    "monaco-editor": "^0.57.0",
    "monaco-yaml": "^5.5.1",
    "nanoid": "^6.0.1",
    "qrcode.react": "^4.2.0",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "react-error-boundary": "6.1.6",
    "react-hook-form": "^7.88.0",
    "react-i18next": "17.1.8",
    "react-markdown": "10.1.0",
    "react-router": "^8.4.0",
    "rehype-raw": "^7.0.0",
    "rehype-sanitize": "^6.0.0",
    "remark-gfm": "^4.0.1",
    "swr": "^2.5.1",
    "tauri-plugin-mihomo-api": "github:clash-verge-rev/tauri-plugin-mihomo#main",
    "types-pac": "^1.0.3",
    "validator": "^13.15.35"
  },
  "devDependencies": {
    "@actions/github": "^9.1.1",
    "@tauri-apps/cli": "2.12.3",
    "@types/lodash-es": "^4.17.12",
    "@types/node": "^24.13.6",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@types/validator": "^13.15.10",
    "@vitejs/plugin-legacy": "^8.2.3",
    "@vitejs/plugin-react": "^6.1.1",
    "@wdio/tauri-service": "1.5.0",
    "adm-zip": "^0.6.1",
    "axios": "^1.20.0",
    "cli-color": "^2.0.4",
    "commander": "^15.0.0",
    "eslint-plugin-es-x": "^10.0.1",
    "eslint-plugin-sukka": "^10.2.0",
    "eslint-plugin-unused-imports": "^4.4.1",
    "glob": "^13.0.6",
    "https-proxy-agent": "^9.1.0",
    "husky": "^9.1.7",
    "jsdom": "^30.1.3",
    "knip": "6.43.0",
    "lint-staged": "^17.5.1",
    "oxfmt": "0.74.0",
    "oxlint": "1.89.0",
    "oxlint-tsgolint": "7.0.2004",
    "sass": "^1.104.1",
    "tar": "^7.5.22",
    "terser": "^5.51.2",
    "typescript": "^6.0.3",
    "vite": "^8.3.0",
    "vite-plugin-svgr": "^5.2.0",
    "vitest": "^5.0.1",
    "webdriverio": "10.1.0",
    "ws": "8.22.0"
  },
  "lint-staged": {
    "*.{js,jsx,ts,tsx,mjs,cjs,mts,cts}": [
      "oxlint --fix --no-error-on-unmatched-pattern",
      "oxfmt --no-error-on-unmatched-pattern"
    ],
    "*.{json,jsonc,css,scss}": [
      "oxfmt --no-error-on-unmatched-pattern"
    ]
  },
  "type": "module",
  "packageManager": "bun@1.4.3"
}
