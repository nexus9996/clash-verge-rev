{
  "$schema": "./node_modules/oxfmt/configuration_schema.json",
  "useTabs": false,
  "tabWidth": 2,
  "printWidth": 80,
  "singleQuote": true,
  "jsxSingleQuote": false,
  "quoteProps": "as-needed",
  "trailingComma": "all",
  "semi": false,
  "arrowParens": "always",
  "bracketSameLine": false,
  "bracketSpacing": true,
  "ignorePatterns": [
    "dist",
    "node_modules",
    "src-tauri/target",
    "src-tauri/gen",
    "src/routeTree.gen.ts",
    "target",
    "Cargo.lock",
    "bun.lock",
    "README.md",
    "Changelog.md",
    "CONTRIBUTING.md",
    ".changelog_backups",
    ".github",
    ".vfox",
    "**/*.md",
    "**/*.mdx",
    "**/*.yml",
    "**/*.yaml",
    "**/*.toml",
    "**/*.html"
  ],
  "sortPackageJson": false,
  "sortImports": false
}
